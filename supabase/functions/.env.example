# Coach Edge Function settings. Copy to supabase/functions/.env (git-ignored)
# for `supabase functions serve` and the smoke test. On the hosted project
# these are function secrets: `supabase secrets set --env-file ...`.
# See docs/coach.md, "Configuration".

# Set to false to turn the Coach off for everyone.
COACH_ENABLED=true

# The Google AI Studio key. Never commit a real one.
COACH_API_KEY=

# Native Gemini endpoint (responseJsonSchema). The OpenAI-compatible one is
# https://generativelanguage.googleapis.com/v1beta/openai
COACH_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Check the current model IDs in AI Studio.
COACH_MODEL=gemini-2.5-flash-lite
COACH_FALLBACK_MODEL=gemini-2.5-flash

COACH_USER_DAILY_LIMIT=20
# About 90% of the project's real daily request quota in AI Studio.
COACH_GLOBAL_DAILY_LIMIT=200
