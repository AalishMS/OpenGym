<?xml version="1.0" encoding="utf-8"?>
<!--
  Grants the system installer read access to the one directory the updater
  writes into. DownloadManager saves the update to
  getExternalFilesDir("updates"), and <external-files-path> is rooted at
  getExternalFilesDir(null), so this exposes exactly that folder.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="updates" path="updates/"/>
</paths>
